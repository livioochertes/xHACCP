    "test:wms": "tsx --test server/wms-contract.test.ts && node scripts/validate-wms-openapi.mjs",
    "validate:wms-openapi": "node scripts/validate-wms-openapi.mjs",
    "test:wms-monitor": "node --test scripts/check-wms-production.test.mjs",
